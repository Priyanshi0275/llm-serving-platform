          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(vllm:request_queue_time_seconds_sum[30s]) / rate(vllm:request_queue_time_seconds_count[30s])",
          "legendFormat": "{{run}}",
