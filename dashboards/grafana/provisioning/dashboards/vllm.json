        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(vllm:time_to_first_token_seconds_sum[30s]) / rate(vllm:time_to_first_token_seconds_count[30s])",
          "legendFormat": "{{run}}",
          "refId": "A"
        }
